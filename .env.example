# Copy this file to ".env" and fill it in. ".env" is never committed.

# PostgreSQL connection string (production / VPS).
# Leave empty on your PC to use the built-in local database (PGlite in .data/pglite).
DATABASE_URL=
# DATABASE_URL=postgres://ielts:CHANGE_ME@db:5432/ielts

# Optional overrides
# PGLITE_DIR=.data/pglite
# UPLOAD_DIR=.data/uploads
